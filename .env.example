# Core services
APP_ENV=local_dev
AGENT_SERVER_URL=http://127.0.0.1:5051
TOOL_SERVER_URL=http://127.0.0.1:5050
REQUEST_TIMEOUT_SECONDS=30

# Agent planning: mock, local NVIDIA NIM/Ollama, or hosted OpenAI
MODEL_MODE=mock
MODEL_PROVIDER=nim
MODEL_API=chat_completions
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_NAME=mock
MODEL_API_KEY=local-dev-key
MODEL_REASONING_EFFORT=low
MODEL_TEXT_VERBOSITY=low

# Speech to text: choose openai or elevenlabs
TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_STT_MODEL=scribe_v2

# Spoken responses: choose windows_sapi, openai, or elevenlabs
VOICE_AGENT_TTS_MODE=windows_sapi
VOICE_AGENT_TTS_VOICE=
VOICE_AGENT_TTS_MODEL=gpt-4o-mini-tts
VOICE_AGENT_TTS_RESPONSE_FORMAT=mp3
VOICE_AGENT_TTS_SPEED=1.0
VOICE_AGENT_TTS_INSTRUCTIONS=Speak like a calm, warm PC accessibility assistant. Use natural pacing and clear pronunciation.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Local voice loop
VOICE_AGENT_WAKE_MODE=whisper_poll
VOICE_AGENT_WAKE_WORDS=jarvis,computer
VOICE_AGENT_OPENWAKEWORD_MODELS=hey_jarvis
VOICE_AGENT_OPENWAKEWORD_THRESHOLD=0.5
VOICE_AGENT_OPENWAKEWORD_FRAME_MS=80
VOICE_AGENT_CHUNK_SECONDS=4
VOICE_AGENT_SILENCE_SECONDS=1.0
VOICE_AGENT_MIN_RECORD_SECONDS=0.8
VOICE_AGENT_SAMPLE_RATE=16000
VOICE_AGENT_CHANNELS=1
VOICE_AGENT_INPUT_DEVICE=
VOICE_AGENT_SUBMITTED_ACK=I'm on it.
VOICE_AGENT_ACCESSIBILITY_ACK=Of course. Let me take a look.
VOICE_AGENT_LISTENING_ACK=I'm here.
VOICE_AGENT_OUTCOME_WAIT_SECONDS=2.5
VOICE_AGENT_FINAL_OUTCOME_WAIT_SECONDS=25

# Desktop tool server
TOOL_MODE=mock_windows
DEFAULT_DOWNLOADS_PATH=C:\Users\Raed\Downloads
FAKE_WINDOWS_ROOT=../../sandbox/fake_windows_home
BROWSER_AUTOMATION_ENABLED=false
BROWSER_USER_DATA_DIR=
BROWSER_PROFILE_DIR=Default
BROWSER_HEADLESS=false
BROWSER_CHROME_EXECUTABLE=
VITE_AGENT_SERVER_URL=http://127.0.0.1:5051

# Optional integrations
CANVAS_API_TOKEN=
GMAIL_CLIENT_SECRETS_PATH=
GMAIL_TOKEN_PATH=.secrets/gmail_token.json
