APP_ENV=windows_dev

# Agent server
AGENT_SERVER_URL=http://127.0.0.1:5051
TOOL_SERVER_URL=http://127.0.0.1:5050
REQUEST_TIMEOUT_SECONDS=15

# Model layer
# Use "mock" for the current reliable demo path.
# Switch to "openai_compatible" when local NVIDIA NIM is serving /v1/chat/completions.
MODEL_MODE=mock
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_NAME=mock
MODEL_API_KEY=local-dev-key

# Temporary development speech-to-text path.
# Keep this server-side only; never expose the key in the dashboard.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1

# Demo target path. The tool server maps this Windows path into FAKE_WINDOWS_ROOT.
DEFAULT_DOWNLOADS_PATH=C:\Users\Raed\Downloads

# Tool server
TOOL_MODE=mock_windows
FAKE_WINDOWS_ROOT=../../sandbox/fake_windows_home

# Dashboard
VITE_AGENT_SERVER_URL=http://127.0.0.1:5051

# Local voice agent
# manual: type commands into the voice-agent console.
# whisper_poll: record short local mic chunks and use /voice/wake-detect.
VOICE_AGENT_WAKE_MODE=whisper_poll
VOICE_AGENT_WAKE_WORDS=jarvis,computer
# Max seconds for a single utterance after speech starts.
VOICE_AGENT_CHUNK_SECONDS=8
# Stop recording after this much silence, instead of sending a fixed-length chunk early.
VOICE_AGENT_SILENCE_SECONDS=1.8
VOICE_AGENT_MIN_RECORD_SECONDS=1.2
VOICE_AGENT_SPEECH_THRESHOLD=350
VOICE_AGENT_LISTEN_BLOCK_MS=100
VOICE_AGENT_SAMPLE_RATE=16000
VOICE_AGENT_CHANNELS=1
# Optional: set to a sounddevice index or name, for example 6 or Microphone (fifine Microphone).
VOICE_AGENT_INPUT_DEVICE=
VOICE_AGENT_TTS_MODE=windows_sapi
VOICE_AGENT_ACK=Of course, here you go.
VOICE_AGENT_LISTENING_ACK=I'm listening.
